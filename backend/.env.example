# Ambiente de Execução (development | production)
NODE_ENV=development
PORT=3001

# Banco de Dados PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bot_prospeccao?schema=public"

# Chave Secreta para Autenticação JWT (Gere uma chave segura e aleatória para produção)
JWT_SECRET="sua_chave_secreta_super_segura_aqui_32_caracteres"

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGIN="http://localhost:3000"

# Conexão com Redis (BullMQ)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
# REDIS_PASSWORD=""
# REDIS_URL="redis://localhost:6379"

# Observabilidade (opcional) — DSN do projeto no sentry.io
# SENTRY_DSN="https://...@...ingest.sentry.io/..."

# Webhook: configure exatamente o mesmo segredo no painel Cakto (sem fallback).
CAKTO_WEBHOOK_SECRET=""
# E-mails elegíveis para cadastro administrativo, após confirmação por código.
# Administradores existentes continuam autorizados pelo role no banco.
# ADMIN_EMAILS="admin@suaempresa.com"

# Obrigatório para ativar contas pré-criadas por pagamento e novos administradores.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Disparador <noreply@seu-dominio.com>"
RESEND_REPLY_TO="suporte@seu-dominio.com"
