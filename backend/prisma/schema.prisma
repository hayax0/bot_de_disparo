generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  name                  String?
  role                  String    @default("USER") // USER, ADMIN
  subscriptionStatus    String    @default("INACTIVE") // ACTIVE, INACTIVE, PAST_DUE, CANCELED, LIFETIME
  subscriptionExpiresAt DateTime?
  caktoCustomerId       String?
  caktoSubscriptionId   String?
  caktoOrderId          String?
  subscriptionStartedAt DateTime?
  subscriptionCanceledAt DateTime?
  subscriptionRenewedAt DateTime?
  subscriptionInterval  String?
  termsAcceptedAt       DateTime?
  termsVersion          String?
  authVersion           Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspaces            Workspace[]
  notifications         SubscriptionNotification[]
  passwordResetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  requestedAt DateTime  @default(now())
  consumedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  userId    String
  lastMessageComSite String?           @db.Text
  lastMessageSemSite String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]
  dispatchHistory  DispatchHistory[]
  whatsapp         WhatsappSession?
}

model DispatchHistory {
  id               String    @id @default(uuid())
  workspaceId      String
  companyTitle     String
  phone            String
  website          String?
  neighborhood     String?
  firstSentAt      DateTime  @default(now())
  lastSentAt       DateTime  @default(now())
  lastMessage      String?   @db.Text
  lastCampaignName String?
  sendCount        Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@index([workspaceId, phone])
  @@index([workspaceId, lastSentAt])
}

model WhatsappSession {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  status      String   @default("DISCONNECTED") // DISCONNECTED, QRCODE, CONNECTED
  sessionData String?  // Stores authentication data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Campaign {
  id             String   @id @default(uuid())
  workspaceId    String
  name           String
  status         String   @default("PAUSED")
  messageComSite String?
  messageSemSite String?
  delayMin       Int      @default(90) // seconds
  delayMax       Int      @default(180) // seconds
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]
}

model Lead {
  id             String    @id @default(uuid())
  campaignId     String
  title          String
  phone          String
  website        String?
  neighborhood   String?
  status         String    @default("PENDING") // PENDING, QUEUED, SENDING, SENT, DELIVERED, READ, REPLIED, ERROR, IGNORED
  errorMessage   String?
  messageContent String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  wppMessageId   String?
  sendStartedAt  DateTime? // Barreira durável: envio iniciado não pode ser repetido automaticamente.
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([wppMessageId])
}

model WebhookLog {
  id          String   @id @default(uuid())
  provider    String   @default("cakto") // cakto
  eventId     String?  // transaction id / event id
  idempotencyKey String? @unique
  event       String   // purchase_approved, subscription_renewed, etc.
  email       String?
  payload     String   @db.Text
  processedAt DateTime @default(now())

  @@index([provider, eventId])
  @@index([email])
}

model RegistrationVerification {
  email       String   @id
  codeHash    String
  expiresAt   DateTime
  requestedAt DateTime @default(now())
  attempts    Int      @default(0)
}

model SubscriptionNotification {
  id             String    @id @default(uuid())
  userId         String
  type           String    // WELCOME, EXPIRATION_7_DAYS, EXPIRATION_1_DAY, RENEWED, PAYMENT_FAILED, CANCELED
  cycle          String    // Identificador do ciclo: 'WELCOME' ou 'YYYY-MM-DD'
  recipientEmail String
  resendEmailId  String?
  status         String    @default("SENT") // SENT, FAILED
  errorMessage   String?
  sentAt         DateTime  @default(now())
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, cycle])
  @@index([userId])
  @@index([recipientEmail])
}
