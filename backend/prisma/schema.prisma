generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  name                  String?
  role                  String    @default("USER") // USER, ADMIN
  subscriptionStatus    String    @default("INACTIVE") // ACTIVE, INACTIVE, PAST_DUE, CANCELED, LIFETIME
  subscriptionExpiresAt DateTime?
  caktoCustomerId       String?
  caktoSubscriptionId   String?
  caktoOrderId          String?
  subscriptionStartedAt DateTime?
  subscriptionCanceledAt DateTime?
  subscriptionRenewedAt DateTime?
  subscriptionInterval  String?
  termsAcceptedAt       DateTime?
  termsVersion          String?
  authVersion           Int       @default(0)
  emailVerifiedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  planId                String?   // START, PRO, SCALE, LEGACY_DAVI, ADMIN_LIFETIME
  monthlyDispatchQuota  Int       @default(0) // 0 = sem restrição por plano ou administrado
  dispatchesUsedInCycle Int       @default(0)
  cycleResetAt          DateTime?
  wallet                CreditWallet?
  creditReservations    CreditReservation[]
  dispatchReservations  DispatchReservation[]
  purchaseOrders        CreditPurchaseOrder[]
  companySearches       CompanySearch[]
  aiConversations       AiConversation[]

  workspaces            Workspace[]
  notifications         SubscriptionNotification[]
  passwordResetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  requestedAt DateTime  @default(now())
  consumedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  userId    String
  lastMessageComSite String?           @db.Text
  lastMessageSemSite String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]
  dispatchHistory  DispatchHistory[]
  whatsapp         WhatsappSession?
  blacklist        Blacklist[]
  auditLogs        AuditLog[]
  companySearches  CompanySearch[]
  aiConversations  AiConversation[]
  deliveredContacts DeliveredWorkspaceContact[]
}

model Blacklist {
  id          String    @id @default(uuid())
  scope       String    // GLOBAL ou WORKSPACE
  workspaceId String?
  phone       String
  reason      String    // OPT_OUT, MANUAL, COMPLAINT, INVALID
  source      String    // INCOMING_MESSAGE, USER_ACTION, ADMIN_ACTION
  metadata    String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([workspaceId, phone])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String?
  action      String   // BLACKLIST_ADD, BLACKLIST_REMOVE, ANONYMIZE_LEAD, SETTINGS_UPDATE, GLOBAL_BLOCK
  targetType  String   // LEAD, BLACKLIST, CAMPAIGN, WORKSPACE
  targetId    String?
  details     String?  @db.Text
  ip          String?
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([action])
}

model DispatchHistory {
  id               String    @id @default(uuid())
  workspaceId      String
  companyTitle     String
  phone            String
  website          String?
  neighborhood     String?
  firstSentAt      DateTime  @default(now())
  lastSentAt       DateTime  @default(now())
  lastMessage      String?   @db.Text
  lastCampaignName String?
  sendCount        Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@index([workspaceId, phone])
  @@index([workspaceId, lastSentAt])
}

model WhatsappSession {
  id          String   @id @default(uuid())
  workspaceId String   @unique
  status      String   @default("DISCONNECTED") // DISCONNECTED, QRCODE, CONNECTED
  sessionData String?  // Stores authentication data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Campaign {
  id                  String   @id @default(uuid())
  workspaceId         String
  name                String
  status              String   @default("PAUSED")
  messageComSite      String?
  messageSemSite      String?
  delayMin            Int      @default(90) // seconds
  delayMax            Int      @default(180) // seconds
  // Campos legados mantidos para compatibilidade de banco; não restringem envios.
  scheduleStartMinute Int      @default(480) // 08:00 (minutos desde 00:00)
  scheduleEndMinute   Int      @default(1200) // 20:00 (minutos desde 00:00)
  scheduleDays        String   @default("1,2,3,4,5,6") // Dias da semana: 0=Dom, 1=Seg..6=Sab
  scheduleTimezone    String   @default("America/Sao_Paulo")
  recontactAfterDays  Int      @default(30)
  createdAt           DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]
}

model Lead {
  id             String    @id @default(uuid())
  campaignId     String
  title          String
  phone          String
  website        String?
  neighborhood   String?
  status         String    @default("PENDING") // PENDING, QUEUED, SENDING, SENT, DELIVERED, READ, REPLIED, ERROR, IGNORED
  errorMessage   String?
  messageContent String?
  attempts       Int       @default(0)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  wppMessageId   String?
  sendStartedAt  DateTime? // Barreira durável: envio iniciado não pode ser repetido automaticamente.
  optedOutAt     DateTime? // Data de opt-out (LGPD)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([wppMessageId])
}

model WebhookLog {
  id          String   @id @default(uuid())
  provider    String   @default("cakto") // cakto
  eventId     String?  // transaction id / event id
  idempotencyKey String? @unique
  event       String   // purchase_approved, subscription_renewed, etc.
  email       String?
  payload     String   @db.Text
  processedAt DateTime @default(now())

  @@index([provider, eventId])
  @@index([email])
}

model RegistrationVerification {
  email       String   @id
  codeHash    String
  expiresAt   DateTime
  requestedAt DateTime @default(now())
  attempts    Int      @default(0)
}

model SubscriptionNotification {
  id             String    @id @default(uuid())
  userId         String
  type           String    // WELCOME, EXPIRATION_7_DAYS, EXPIRATION_1_DAY, RENEWED, PAYMENT_FAILED, CANCELED
  cycle          String    // Identificador do ciclo: 'WELCOME' ou 'YYYY-MM-DD'
  recipientEmail String
  resendEmailId  String?
  status         String    @default("SENT") // SENT, FAILED
  errorMessage   String?
  sentAt         DateTime  @default(now())
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, cycle])
  @@index([userId])
  @@index([recipientEmail])
}

model CreditWallet {
  id               String              @id @default(uuid())
  userId           String              @unique
  monthlyBalance   Int                 @default(0) // Consumido primeiro; expira no ciclo
  purchasedBalance Int                 @default(0) // Consumido depois; acumula sem expirar
  reservedBalance  Int                 @default(0) // Hold ativo em operações pendentes
  monthlyExpiresAt DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     CreditTransaction[]
  reservations     CreditReservation[]
}

model CreditReservation {
  id              String        @id @default(uuid())
  walletId        String
  userId          String
  idempotencyKey  String        @unique
  amount          Int           // Valor total retido
  monthlyAmount   Int           @default(0) // Quantidade retida de monthlyBalance
  purchasedAmount Int           @default(0) // Quantidade retida de purchasedBalance
  status          String        @default("PENDING") // PENDING, SETTLED, RELEASED, EXPIRED
  sourceType      String        // COMPANY_SEARCH, AI_ASSISTANT
  sourceId        String?
  description     String?
  consumedAmount  Int?          // Valor efetivamente consumido na liquidação
  settledAt       DateTime?
  releasedAt      DateTime?
  expiresAt       DateTime?
  monthlyExpiresAt DateTime?    // Validade do ciclo mensal original no momento da retenção
  metadata        String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  wallet          CreditWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([walletId])
  @@index([sourceType, sourceId])
}

model CreditTransaction {
  id              String        @id @default(uuid())
  walletId        String
  userId          String
  amount          Int           // Positivo (crédito) ou negativo (débito)
  type            String        // MONTHLY_GRANT, PURCHASE_GRANT, RESERVATION_HOLD, RESERVATION_RELEASE, CONSUMPTION, EXPIRATION, ADMIN_ADJUSTMENT, REFUND_REVOCATION
  balanceType     String        // MONTHLY, PURCHASED, MIXED, NONE
  monthlyAmount   Int           @default(0)
  purchasedAmount Int           @default(0)
  sourceType      String        // COMPANY_SEARCH, AI_ASSISTANT, SUBSCRIPTION_RENEWAL, CREDIT_PURCHASE, ADMIN_MANUAL
  sourceId        String?
  idempotencyKey  String?       @unique
  description     String
  metadata        String?       @db.Text
  createdAt       DateTime      @default(now())

  wallet          CreditWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId])
  @@index([sourceType, sourceId])
}

model CreditPurchaseOrder {
  id              String    @id @default(uuid())
  userId          String
  packageId       String    // PACKAGE_SMALL, PACKAGE_MEDIUM, PACKAGE_LARGE
  credits         Int
  priceCents      Int
  currency        String    @default("BRL")
  status          String    @default("PENDING") // PENDING, PAID, CANCELED, REFUNDED
  paymentProvider String    @default("cakto")
  caktoOrderId    String?
  caktoPaymentUrl String?
  idempotencyKey  String?   @unique
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([caktoOrderId])
}

model CompanySearch {
  id              String                @id @default(uuid())
  workspaceId     String
  userId          String
  targetCampaignId String?
  reservationId   String?
  idempotencyKey  String?               @unique
  query           String
  segment         String?
  location        String?
  requestedCount  Int
  foundCount      Int                   @default(0)
  usableCount     Int                   @default(0)
  discardedCount  Int                   @default(0)
  creditsReserved Int                   @default(0)
  creditsConsumed Int                   @default(0)
  status          String                @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELED
  errorMessage    String?
  apifyRunId      String?
  apifyActorId    String?
  providerCost    Float?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  results         CompanySearchResult[]

  @@index([workspaceId, createdAt])
  @@index([userId])
}

model CompanySearchResult {
  id             String        @id @default(uuid())
  searchId       String
  workspaceId    String
  name           String
  phone          String?
  website        String?
  address        String?
  neighborhood   String?
  city           String?
  category       String?
  rating         Float?
  reviewsCount   Int?
  isUsable       Boolean       @default(false)
  discardReason  String?       // NO_PHONE, DUPLICATE, BLACKLISTED, INVALID_PHONE
  importedLeadId String?
  createdAt      DateTime      @default(now())

  search         CompanySearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId])
  @@index([workspaceId, phone])
}

model AiConversation {
  id          String      @id @default(uuid())
  userId      String
  workspaceId String
  title       String      @default("Nova conversa")
  creditsUsed Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    AiMessage[]

  @@index([userId, updatedAt])
  @@index([workspaceId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String         // user, assistant, system, tool
  content        String         @db.Text
  toolCalls      String?        @db.Text
  toolResult     String?        @db.Text
  tokensUsed     Int            @default(0)
  creditsCharged Int            @default(0)
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model DispatchReservation {
  id          String   @id @default(uuid())
  userId      String
  dispatchKey String
  cycleKey    String
  status      String   @default("RESERVED") // RESERVED, CONFIRMED, RELEASED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleKey, dispatchKey])
  @@index([userId, cycleKey])
  @@index([dispatchKey])
}

model DeliveredWorkspaceContact {
  id          String   @id @default(uuid())
  workspaceId String
  phone       String
  searchId    String
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
  @@index([workspaceId])
}
