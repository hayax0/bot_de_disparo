{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "backend": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["whatsapp-web.js", "tsx"]
    },
    "frontend": {
      "entry": ["src/app/**/page.tsx", "src/app/**/layout.tsx", "next.config.ts", "instrumentation.ts", "instrumentation-client.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss", "autoprefixer", "postcss"]
    }
  }
}
