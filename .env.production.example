# ==========================================
# SAAS BOT - CONFIGURAÇÃO DE PRODUÇÃO (VPS)
# ==========================================

# 1. Banco de Dados PostgreSQL
POSTGRES_DB=saas_bot_db
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=gere_uma_senha_muito_forte_aqui_123!

# 2. Redis Protegido (Obrigatório para BullMQ e Rate Limit)
# Gere com: openssl rand -hex 24
REDIS_PASSWORD=gere_uma_senha_muito_forte_para_o_redis_aqui

# 3. Segurança e Autenticação
# Gere uma chave com: openssl rand -base64 32
JWT_SECRET=gere_uma_chave_jwt_secreta_longa_e_aleatoria_aqui
CRON_SECRET=gere_um_segredo_forte_para_o_cron_aqui

# 4. Domínios e URLs (CORS & Frontend)
# Exemplo em produção: https://botdisparo.cmpx.tec.br
CORS_ORIGIN=https://botdisparo.cmpx.tec.br
PLATFORM_URL=https://botdisparo.cmpx.tec.br
NEXT_PUBLIC_API_URL=/api

# 5. Portas Locais (Bind exclusivo em 127.0.0.1 pelo docker-compose)
FRONTEND_PORT=3000
BACKEND_PORT=3001

# 6. Observabilidade e Monitoramento — DSN do projeto no sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# 7. Webhook Cakto e Notificações de E-mail (Resend)
CAKTO_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL="CMPX Bot Disparo <noreply@botdisparo.cmpx.tec.br>"
RESEND_REPLY_TO=cmpxsuporte@gmail.com

# 8. Administradores Elegíveis (Opcional - apenas para concluir cadastro administrativo)
# ADMIN_EMAILS=seu_email@dominio.com

# 9. Rotinas de Backup Operacional (scripts/backup-db.sh)
# APP_DIR=/opt/saas-bot
# BACKUP_DIR=/opt/saas-bot/backups
# RETENTION_DAYS=7
