# ==========================================
# SAAS BOT - CONFIGURAÇÃO DE PRODUÇÃO
# ==========================================

# 1. Banco de Dados PostgreSQL
POSTGRES_DB=saas_bot_db
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=gere_uma_senha_muito_forte_aqui_123!

# 2. Segurança e Autenticação
# Gere uma chave com: openssl rand -base64 32
JWT_SECRET=gere_uma_chave_jwt_secreta_longa_e_aleatoria_aqui

# 3. Domínios e URLs (CORS & Frontend)
# Exemplo em produção: https://app.meudominio.com
CORS_ORIGIN=https://app.meudominio.com
NEXT_PUBLIC_API_URL=https://api.meudominio.com/api

# 4. Portas Públicas
FRONTEND_PORT=3000
BACKEND_PORT=3001

# 5. Observabilidade (opcional) — DSN do projeto no sentry.io
# Ativa envio de erros do backend e frontend para o Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
